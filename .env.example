# Copy this file to .env and fill in real values before running docker compose.

# --- Postgres ---
POSTGRES_DB=USE your credential
POSTGRES_USER=USE your credential
POSTGRES_PASSWORD=USE your credential

# --- Auth ---
# Shared secret used by BOTH backend (issues JWTs) and ai-service (validates them).
# Must match across both services. Generate a real random value for anything beyond local dev.
JWT_SECRET=dev-only-change-me-in-prod-please

# --- AI service integrations (Step 4+) ---
HUGGINGFACE_API_KEY=
TAVILY_API_KEY=pest_your_key
SERPER_API_KEY=

#-----AI models API keys-----
GEMINI_API_KEY=your-gemini-key
EDUAI_GROQ_KEY=your-groq-key
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=Gemini 3.1 Flash Lite
LLM_VERIFY=true